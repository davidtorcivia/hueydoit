# Huey Do It - Environment Configuration

# Port for the web UI and API
HUE_CONTROLLER_PORT=8585

# OpenWeatherMap API key (free tier)
OPENWEATHERMAP_API_KEY=your_api_key_here

# Location for weather and solar calculations
LATITUDE=40.704941
LONGITUDE=-73.914642

# Timezone
TZ=America/New_York

# Encryption key for bridge credentials (auto-generated if empty)
ENCRYPTION_KEY=

# Hue bridge IP (leave empty for mDNS discovery)
HUE_BRIDGE_IP=

# Minutes before an external override expires (default: 30)
EXTERNAL_OVERRIDE_TIMEOUT_MIN=30

# Database path (relative to app root)
DB_PATH=data/huey-do-it.db
